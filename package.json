{
  "name": "synaps-ai-solutions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx,mjs,cjs --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:content": "node scripts/check-scripts.mjs",
    "check:rtl": "node scripts/verify-site.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:smoke": "node scripts/run-smoke.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check:whatsapp": "node scripts/check-whatsapp.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "og": "node scripts/render-og.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check:interactions": "node scripts/check-interactions.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:content && npm run check:rtl && npm run check:whatsapp && npm run check:links && npm run check:a11y && npm run check:smoke && npm run build && npm run check:css && npm run check:csp",
    "verify:browser": "node scripts/check-browser.mjs && node scripts/check-interactions.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "lucide-react": "^0.323.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "esbuild": "^0.21.5",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.0"
  }
}
