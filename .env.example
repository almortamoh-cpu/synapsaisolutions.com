# ------------------------------------------------------------------
# Synaps AI Solutions — environment template
# Copy to `.env` (or `.env.local`) and fill in real values.
# ------------------------------------------------------------------

# SECURITY — READ THIS FIRST
#
# Vite inlines every variable prefixed with VITE_ directly into the
# client bundle. Anything you put here is PUBLIC to anyone who opens
# the site, including a model provider's API key.
#
#   ✅ DO    put internal service URLs here (VITE_CONTACT_FORM_ENDPOINT,
#            VITE_AI_ASSISTANT_ENDPOINT)
#   ❌ DON'T put provider API keys, database credentials, passwords,
#            signing secrets, or private tokens here
#
# Model provider keys must live ONLY in the backend that proxies the
# request, and must be read from that backend's own environment.
# ------------------------------------------------------------------


# Backend endpoint that receives the contact form payload.
# Leave unset to run the form in clearly-labelled demo mode.
# The backend is responsible for validation, CSRF protection,
# rate limiting, spam filtering, and delivering the message.
# VITE_CONTACT_FORM_ENDPOINT=https://api.synapsaisolutions.com/contact


# Server-side proxy for the AI Assistant.
# This must be YOUR backend route which holds the model provider key —
# never point it directly at a model provider, or the key is exposed.
# Expected request:  POST { message, lang, history[] }
# Expected response: { "reply": "string" }
# VITE_AI_ASSISTANT_ENDPOINT=https://api.synapsaisolutions.com/ai/chat


# ------------------------------------------------------------------
# Non-public (backend-only) variables — reference only, do NOT uncomment
# these in a frontend .env file.
# ------------------------------------------------------------------
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# DATABASE_URL=...
# SMTP_PASSWORD=...