# Cache and security headers for Netlify and Cloudflare Pages.
# Ignored by hosts that do not read _headers (Vercel, GitHub Pages).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  X-# Fonts are self-hosted (Fontsource, emitted into /assets), so the policy needs
  # no Google origins at all. Every subresource now comes from this origin,
  # which is why font-src and connect-src stay on 'self' only.
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Vite emits content-hashed filenames, so these can be cached indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/og-image.png
  Cache-Control: public, max-age=604800

# The HTML shell must never be cached, or visitors get a stale app after deploy.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800

/manifest.json
  Cache-Control: public, max-age=3600